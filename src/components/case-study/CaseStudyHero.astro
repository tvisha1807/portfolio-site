---
interface Props {
  title: string;
  tag?: string;
}

const { title, tag } = Astro.props;
---

<header class="space-y-2 md:space-y-3">
  {tag && (
    <p class="text-base md:text-lg xl:text-xl font-bold text-accent">{tag}</p>
  )}
  <h1 class="text-[36px] md:text-[48px] xl:text-[64px] font-bold leading-tight text-black">
    {title}
  </h1>
</header>
