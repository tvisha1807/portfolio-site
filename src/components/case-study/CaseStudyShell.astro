---
interface Props {
  showBlobs?: boolean;
}

const { showBlobs = true } = Astro.props;
---

<article class="relative overflow-hidden pb-24 md:pb-32 xl:pb-36">
  {
    showBlobs && (
      <>
        <img
          src="/assets/hero-blob-left.svg"
          alt=""
          class="absolute top-[8%] -left-[12%] w-[28vw] max-w-[380px] xl:max-w-[500px] opacity-60 pointer-events-none hidden md:block"
        />
        <img
          src="/assets/hero-blob-right.svg"
          alt=""
          class="absolute top-[35%] -right-[12%] w-[32vw] max-w-[450px] xl:max-w-[600px] opacity-60 rotate-[134deg] pointer-events-none hidden md:block"
        />
        <img
          src="/assets/hero-blob-left.svg"
          alt=""
          class="absolute bottom-[20%] -left-[15%] w-[22vw] max-w-[320px] opacity-40 pointer-events-none hidden md:block"
        />
      </>
    )
  }

  <div
    class="relative max-w-[1512px] mx-auto px-6 md:px-12 xl:px-[108px] pt-6 md:pt-10 xl:pt-12 space-y-16 md:space-y-20 xl:space-y-28"
  >
    <slot />
  </div>
</article>
