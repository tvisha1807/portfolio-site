---
export interface CaseStudyStat {
  metric: string;
  description: string;
  iconSrc?: string;
  iconAlt?: string;
}

interface Props {
  stats: CaseStudyStat[];
}

const { stats } = Astro.props;
---

<section class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8 xl:gap-12">
  {
    stats.map(({ metric, description, iconSrc, iconAlt = '' }) => (
      <article class="flex flex-col items-center text-center gap-4 md:gap-5">
        {
          iconSrc ? (
            <img
              src={iconSrc}
              alt={iconAlt}
              class="w-16 h-16 md:w-20 md:h-20 object-contain"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div
              class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-accent-light flex items-center justify-center"
              aria-hidden="true"
            >
              <span class="text-2xl md:text-3xl font-bold text-accent">%</span>
            </div>
          )
        }
        <p class="text-[28px] md:text-[32px] xl:text-[36px] font-bold text-accent leading-tight">
          {metric}
        </p>
        <p class="text-base md:text-lg leading-relaxed text-black max-w-xs">{description}</p>
      </article>
    ))
  }
</section>
