---
export interface VisualCueItem {
  src: string;
  alt: string;
  caption: string;
}

interface Props {
  items: [VisualCueItem, VisualCueItem];
}

const { items } = Astro.props;
---

<div
  class="flex flex-col md:flex-row md:justify-between md:items-start gap-14 md:gap-0 w-full"
>
  {
    items.map(({ src, alt, caption }) => (
      <figure class="flex flex-col items-start gap-3 md:gap-4 max-w-[300px]">
        <img
          src={src}
          alt={alt}
          loading="lazy"
          decoding="async"
          class="w-auto max-w-[200px] md:max-w-[220px] h-auto rounded-xl md:rounded-2xl block"
        />
        <figcaption class="text-sm md:text-base text-muted leading-relaxed max-w-[280px]">
          {caption}
        </figcaption>
      </figure>
    ))
  }
</div>
