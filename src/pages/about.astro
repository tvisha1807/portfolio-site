---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — Tvisha Pandey"
  description="Learn about Tvisha Pandey, a UX designer passionate about creating human-centred digital experiences."
>
  <main class="px-6 py-24 max-w-3xl mx-auto">
    <p class="text-xs uppercase tracking-widest text-gray-400 mb-8">About</p>
    <h1 class="text-4xl md:text-5xl font-display font-medium leading-tight mb-10">
      Designing with intention.
    </h1>

    <div class="prose prose-gray max-w-none">
      <p>
        Hi, I'm Tvisha — a UX designer based in [City]. I help teams turn complex problems into
        clear, beautiful products. My process blends research, systems thinking, and a deep
        curiosity for how people interact with technology.
      </p>
      <p>
        I've worked with [clients/industries]. I'm currently [available for freelance / open to
        opportunities].
      </p>
    </div>

    <div class="mt-16 grid grid-cols-2 md:grid-cols-3 gap-8 text-sm">
      <div>
        <p class="font-medium mb-2">Skills</p>
        <ul class="text-gray-500 space-y-1">
          <li>UX Research</li>
          <li>Interaction Design</li>
          <li>Prototyping</li>
          <li>Design Systems</li>
        </ul>
      </div>
      <div>
        <p class="font-medium mb-2">Tools</p>
        <ul class="text-gray-500 space-y-1">
          <li>Figma</li>
          <li>FigJam</li>
          <li>Maze</li>
          <li>Notion</li>
        </ul>
      </div>
    </div>

    <div class="mt-16">
      <a href="/contact" class="text-sm underline underline-offset-4 hover:text-gray-500 transition-colors">
        Get in touch →
      </a>
    </div>
  </main>
</BaseLayout>
