---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCardFull from '../components/ProjectCardFull.astro';
import ProjectCardSplit from '../components/ProjectCardSplit.astro';
import { getCollection } from 'astro:content';

const featuredProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Tvisha Pandey — UX Designer">
  <!-- Hero -->
  <section class="relative overflow-hidden pt-32 pb-24 md:pt-40 md:pb-32 xl:pt-48 xl:pb-36">
    <img
      src="/assets/hero-blob-left.svg"
      alt=""
      class="absolute top-[10%] -left-[10%] w-[30vw] max-w-[400px] xl:w-[35vw] xl:max-w-[547px] opacity-80 pointer-events-none hidden md:block"
    />
    <img
      src="/assets/hero-blob-right.svg"
      alt=""
      class="absolute top-[40%] -right-[10%] w-[35vw] max-w-[500px] xl:w-[50vw] xl:max-w-[766px] opacity-80 rotate-[134deg] pointer-events-none hidden md:block"
    />

    <div class="relative max-w-[1512px] mx-auto px-6 md:px-12 xl:px-[108px]">
      <p class="text-[24px] md:text-[30px] xl:text-[36px] font-normal mb-1">Hi! I am Tvisha</p>
      <h1 class="text-[32px] md:text-[48px] xl:text-[64px] font-bold leading-tight max-w-[1506px]">
        I am a product designer with a Bachelors in Industrial Design. I work towards creating <span class="text-accent">simple and inclusive user experiences.</span>
      </h1>
    </div>
  </section>

  <!-- Projects -->
  <section class="relative overflow-hidden pb-24 md:pb-32 xl:pb-36">
    <div class="max-w-[1512px] mx-auto px-6 md:px-12 xl:px-[108px] pt-16 md:pt-20 xl:pt-24">
      <p class="text-[18px] md:text-[20px] text-black">Projects</p>
      <h2 class="text-[32px] md:text-[42px] xl:text-[54px] font-bold">Recently I made,</h2>
    </div>

    {featuredProjects.map((project, i) =>
      i === 0
        ? <ProjectCardFull project={project} />
        : <ProjectCardSplit project={project} />
    )}

    <img
      src="/assets/hero-blob-left.svg"
      alt=""
      class="absolute bottom-[15%] -left-[15%] w-[25vw] max-w-[350px] xl:w-[30vw] xl:max-w-[450px] opacity-50 pointer-events-none hidden md:block"
    />
    <img
      src="/assets/hero-blob-right.svg"
      alt=""
      class="absolute bottom-[5%] -right-[10%] w-[30vw] max-w-[450px] xl:w-[40vw] xl:max-w-[600px] opacity-50 rotate-[134deg] pointer-events-none hidden md:block"
    />
  </section>
</BaseLayout>
