---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Tvisha Pandey"
  description="Get in touch with Tvisha Pandey for freelance UX design projects."
>
  <main class="px-6 py-24 max-w-2xl mx-auto">
    <p class="text-xs uppercase tracking-widest text-gray-400 mb-8">Contact</p>
    <h1 class="text-4xl md:text-5xl font-display font-medium leading-tight mb-6">
      Let's work together.
    </h1>
    <p class="text-lg text-gray-500 mb-12">
      Have a project in mind? I'm available for freelance engagements and collaborations.
    </p>

    <!-- Web3Forms contact form (free, no backend needed) -->
    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="space-y-6"
    >
      <!-- Replace with your Web3Forms access key from web3forms.com -->
      <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_KEY" />
      <input type="hidden" name="subject" value="New message from tvishapandey.me" />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

      <div>
        <label class="block text-sm font-medium mb-2" for="name">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
          placeholder="Your name"
        />
      </div>

      <div>
        <label class="block text-sm font-medium mb-2" for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
          placeholder="you@example.com"
        />
      </div>

      <div>
        <label class="block text-sm font-medium mb-2" for="message">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent resize-none"
          placeholder="Tell me about your project…"
        ></textarea>
      </div>

      <button
        type="submit"
        class="bg-gray-900 text-white text-sm font-medium px-8 py-3 rounded-full hover:bg-gray-700 transition-colors"
      >
        Send message
      </button>
    </form>

    <div class="mt-16 pt-8 border-t border-gray-100">
      <p class="text-sm text-gray-400">
        Or email directly:
        <a href="mailto:hello@tvishapandey.me" class="underline underline-offset-4 text-gray-700">
          hello@tvishapandey.me
        </a>
      </p>
    </div>
  </main>
</BaseLayout>
